#: wine_cellar/react/maps/ItemPopup.tsx:5
msgctxt "Singular"
msgid "Country"
msgstr "Land"

#: wine_cellar/react/maps/ItemPopup.tsx:6
msgid "Picture of a wine bottle."
msgstr "Foto einer Weinflasche."

#: wine_cellar/react/maps/ItemPopup.tsx:7
